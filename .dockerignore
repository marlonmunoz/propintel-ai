__pycache__
*.pyc
*.pyo
*.pyd
*.db
*.sqlite3
.env
.venv
# .git is intentionally NOT excluded — the Dockerfile runs `git lfs pull`
# during the build to resolve *.pkl and *.parquet pointer files into real
# content.  Removing this entry is required for LFS resolution to work.
# The .git directory is deleted inside the build after `git lfs pull` so it
# does not appear in the final image.
.gitignore
tests
notebooks

# ML raw + silver data — large, not needed at runtime
ml/data/silver/
ml/data/bronze/
ml/data/nyc_raw/
ml/data/pluto_raw/
ml/data/external/
ml/data/processed/
ml/data/features/
# NOTE: ml/data/gold/ is intentionally NOT excluded — Gold parquet files
# (~24 MB total) are the production inference data path for DOF/ACRIS/J-51
# features (ML-CRIT-1 fix).  Do not add ml/data/gold/ here.

# ML training code + experiment outputs — not needed at runtime
ml/models/
ml/pipelines/
ml/artifacts/eval_reports/
ml/artifacts/spine_models_exp/
ml/artifacts/subtype_models/

# Frontend source — built separately, not served by FastAPI
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docs + misc
docs/
*.md
.github/
catboost_info/